{
  "manifest_version": 3,
  "name": "VibeCode Inspector",
  "version": "1.0",
  "description": "Select any element on any webpage and send its context directly to Antigravity.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "VibeCode Inspector",
    "default_icon": {
      "16": "icons/icon16_gray.png",
      "32": "icons/icon32_gray.png",
      "48": "icons/icon48_gray.png",
      "128": "icons/icon128_gray.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
